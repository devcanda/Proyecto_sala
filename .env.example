# Modo de base de datos: "sqlite" (Standalone, 1 PC, sin internet) o
# "postgresql" (Servidor: LAN local via Docker/Portainer, O nube via AWS
# RDS / Azure Database for PostgreSQL). Son despliegues independientes,
# no alternan automaticamente entre si.
DB_MODE=sqlite

# Usado solo si DB_MODE=sqlite. Ruta relativa al archivo dentro de backend/data/
SQLITE_DB_NAME=salsa_pos.db

# Usados solo si DB_MODE=postgresql
POSTGRES_USER=salsa_pos
POSTGRES_PASSWORD=cambiar_esta_clave
# LAN local: localhost / IP del servidor Docker.
# AWS: el endpoint del RDS (ej. salsa-pos.xxxxx.us-east-1.rds.amazonaws.com).
# Azure: el host del recurso Azure Database for PostgreSQL flexible server.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=salsa_pos
# "prefer" alcanza para Docker/Portainer local. En AWS RDS o Azure Database
# usar "require" (o "verify-full" si se valida el certificado del proveedor).
POSTGRES_SSLMODE=prefer

# CORS: origen del frontend en desarrollo (Tauri/Electron local) o el
# dominio publico del frontend cuando el backend corre en la nube.
FRONTEND_ORIGIN=http://localhost:1420
